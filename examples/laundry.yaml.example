# Generic example only.
# Copy to /config/smoobu_workflow/laundry.yaml and customize.
currency: EUR
vat_percent: 19

products:
  duvet_cover:
    position: 1
    name: Deckenbezug
    unit: Stk
    net_unit_price: 2.00
  sheet:
    position: 2
    name: Spannbetttuch
    unit: Stk
    net_unit_price: 1.80
  pillowcase:
    position: 3
    name: Kissenbezug
    unit: Stk
    net_unit_price: 0.80
  towel:
    position: 4
    name: Handtuch
    unit: Stk
    net_unit_price: 0.80
  bath_towel:
    position: 5
    name: Badetuch
    unit: Stk
    net_unit_price: 1.10
  bath_mat:
    position: 6
    name: Badevorleger
    unit: Stk
    net_unit_price: 0.70

# Used by the optional "Lagerbestand / Sets" ordering mode.
# One complete set consists of one of each configured set product.
stock_order:
  set_products:
    duvet_cover: 1
    sheet: 1
    pillowcase: 1
    towel: 1
    bath_towel: 1
  bath_mat_product: bath_mat

houses:
  "123456":
    name: Apartment A
    enabled: false
    laundry:
      duvet_cover: 2
      sheet: 2
      pillowcase: 2
      towel: 2
      bath_towel: 2
      bath_mat: 1

  "234567":
    name: Apartment B
    enabled: false
    laundry:
      duvet_cover: 4
      sheet: 4
      pillowcase: 4
      towel: 4
      bath_towel: 4
      bath_mat: 1
