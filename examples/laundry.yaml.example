# Generic example only.
# Copy to /config/smoobu_workflow/laundry.yaml and customize.
currency: EUR
vat_percent: 19

products:
  flat_fitted_sheet:
    position: 1
    name: Laken
    unit: Stk
    net_unit_price: 2.00
  fitted_sheet:
    position: 2
    name: Spannbetttuch
    unit: Stk
    net_unit_price: 1.80
  pillowcase:
    position: 3
    name: Kissenbezug
    unit: Stk
    net_unit_price: 0.80
  towel:
    position: 4
    name: Handtuch
    unit: Stk
    net_unit_price: 0.80
  bath_towel:
    position: 5
    name: Badetuch
    unit: Stk
    net_unit_price: 1.10
  bath_mat:
    position: 6
    name: Badvorleger
    unit: Stk
    net_unit_price: 0.70

# Used by the optional "Lagerbestand / Sets" ordering mode.
# 1 Set = 1 Kopfkissenbezug + 1 Laken + 1 Spannbetttuch + 1 Badetuch + 1 Handtuch.
# Badvorleger sind KEIN Bestandteil eines Sets und werden separat gezählt.
# Anfangsbestand nach Bestandsaufnahme: 24 Sets, 6 Badvorleger.
# Preise hier sind nur Platzhalter; örtliche Wäschereipreise separat eintragen.
stock_order:
  set_products:
    flat_fitted_sheet: 1
    fitted_sheet: 1
    pillowcase: 1
    towel: 1
    bath_towel: 1
  bath_mat_product: bath_mat

houses:
  "123456":
    name: Apartment A
    enabled: false
    laundry:
      flat_fitted_sheet: 2
      fitted_sheet: 2
      pillowcase: 2
      towel: 2
      bath_towel: 2
      bath_mat: 1

  "234567":
    name: Apartment B
    enabled: false
    laundry:
      flat_fitted_sheet: 4
      fitted_sheet: 4
      pillowcase: 4
      towel: 4
      bath_towel: 4
      bath_mat: 1
